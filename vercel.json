{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/removebg/bg-remove",
      "destination": "/api/removebg/bg-remove.js"
    },
    {
      "source": "/api/proxy-image",
      "destination": "/api/proxy-image.js"
    },
    {
      "source": "/api/magnific/:path*",
      "destination": "/api/magnific/:path*.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Api-Key, Accept" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
